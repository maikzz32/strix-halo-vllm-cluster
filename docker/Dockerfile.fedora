# syntax=docker/dockerfile:1
#
# vLLM gfx1151 (AMD Strix Halo) image, Fedora 44 base.
#
# Build context MUST be the repository root (needs ./patches):
#   podman build -f docker/Dockerfile.fedora \
#     --build-arg ROCM_VERSION=7.14.0 \
#     --build-arg TORCH_VERSION=2.13.0 \
#     --build-arg TORCHVISION_VERSION=0.28.0 \
#     --build-arg VLLM_REF=v0.x.y \
#     --build-arg RCCL_IMPL=stock \
#     -t ghcr.io/<org>/vllm-gfx1151:stable .
#
# Two-stage build: `builder` compiles vLLM / AITER / ROCm flash-attention
# wheels against the full ROCm SDK, the final stage carries the runtime
# (same pip SDK, incl. devel, so Triton/AITER JIT works at runtime) plus the
# prebuilt wheels.
#
# ROCm SDK source: Fedora 44's packaged ROCm is 7.1.x - far too old for the
# torch 2.13+rocm7.14 wheels and missing rocprim/hipcub/rocthrust/miopen/
# comgr/hsakmt entirely. Instead the SDK comes from TheRock pip packages on
# AMD's whl-multi-arch index (the same index that serves the torch wheels):
#   rocm-sdk-core              HIP runtime, comgr, hsa, rocminfo, rocm-smi, llvm
#   rocm-sdk-libraries         host math libs (rocblas/hipblas/rccl/MIOpen/...)
#   rocm-sdk-device-gfx1151    gfx1151 device code (kpack, rocblas .co, ...)
#   rocm-sdk-devel             full dev tree (headers rocprim/hipcub/rocthrust,
#                              cmake configs, hipcc/clang) - embedded tar,
#                              expanded by `rocm-sdk init`
# `rocm-sdk path --root` then prints the ROCm prefix; we symlink it to
# /opt/rocm and point ROCM_PATH/ROCM_HOME/HIP_PATH there.
#
# Python: the gfx1151 torch wheels for the newest aligned stack are cp312
# ONLY (torch 2.13.0+rocm7.14.0), while Fedora 44's default python3 is 3.14.
# We therefore install Fedora's python3.12 package and use it for everything
# (python3 is symlinked to python3.12 in /usr/local/bin).
#
# OWNER MUST VERIFY on first build:
#  - That ROCM_VERSION/TORCH_VERSION/TORCHVISION_VERSION form an aligned set
#    on https://repo.amd.com/rocm/whl-multi-arch/ (build-stable.yml's
#    discover step resolves this automatically).

ARG FEDORA_VERSION=44
FROM fedora:${FEDORA_VERSION} AS builder

ARG ROCM_VERSION=7.14.0
ARG TORCH_VERSION=2.13.0
ARG TORCHVISION_VERSION=0.28.0
ARG VLLM_REF=main
ARG RCCL_IMPL=stock
ARG AITER_REF=v0.1.19
ARG CONCH_VERSION=1.2.1
ARG ROCM_INDEX_URL=https://repo.amd.com/rocm/whl-multi-arch/
# Fedora's rdma-core must be >= v64: fc44 ships v61, which does not know the
# Intel E830 (PCI 8086:12de, node4) and silently drops its RoCE devices at
# provider enumeration (v62 was the earlier floor for irdma "Unknown
# completion" errors). Overlay-built from source only if older.
ARG RDMA_CORE_MIN_MAJOR=64
ARG RDMA_CORE_REF=v64.0

ENV DNF_FLAGS="--setopt=install_weak_deps=False --setopt=tsflags=nodocs"

# --- Build toolchain + python 3.12 ------------------------------------------
# No Fedora ROCm packages: the SDK comes from the TheRock pip wheels (see
# header). numactl-libs/libdrm/libatomic are runtime deps of the HSA thunk
# that the pip SDK does not bundle.
RUN dnf install -y ${DNF_FLAGS} \
        git cmake ninja-build gcc gcc-c++ make which findutils procps-ng \
        rust cargo patch \
        python3.12 python3.12-devel curl-minimal \
        numactl-libs libdrm libdrm-devel libatomic \
    && dnf clean all

# pip for python3.12 (Fedora's python3-pip targets the 3.14 system python) and
# the python3 -> python3.12 symlink so every later step (patch layer, smoke
# test, console scripts) consistently uses the interpreter the wheels target.
RUN curl -fsSL https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py \
    && python3.12 /tmp/get-pip.py --no-cache-dir \
    && rm -f /tmp/get-pip.py \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3

# --- gfx1151 torch stack + full ROCm SDK from AMD's multi-arch index --------
# torch itself pulls rocm[libraries]==<ROCM_VERSION> (core+libraries),
# triton==...rocm<ROCM_VERSION> and rocm-bootstrap; the amd-torch-device
# plugin pulls rocm-sdk-device-gfx1151. Adding rocm[devel] completes the SDK
# (headers + cmake + compilers). torchvision is needed by vLLM multimodal
# code; its version is resolved alongside torch by the CI discover step.
# PyPI is kept as extra-index for the pure-python deps (and the setuptools
# backend needed to build the `rocm` sdist).
RUN python3 -m pip install \
        --index-url "${ROCM_INDEX_URL}" \
        --extra-index-url https://pypi.org/simple \
        "torch==${TORCH_VERSION}+rocm${ROCM_VERSION}" \
        "amd-torch-device-gfx1151==${TORCH_VERSION}+rocm${ROCM_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}+rocm${ROCM_VERSION}" \
        "amd-torchvision-device-gfx1151==${TORCHVISION_VERSION}+rocm${ROCM_VERSION}" \
        "rocm[devel]==${ROCM_VERSION}" \
    && python3 -m pip install pyyaml packaging setuptools wheel ninja cmake

# Expand the embedded devel tar (headers/cmake/compilers, reconciles the
# gfx1151 device links), then expose the SDK at fixed paths: /opt/rocm is the
# ROCm prefix (bin/include/lib/cmake), /opt/rocm-core and /opt/rocm-libraries
# the runtime lib trees.
RUN python3 -m rocm_sdk init \
    && ln -sfn "$(python3 -m rocm_sdk path --root)" /opt/rocm \
    && ln -sfn "$(python3 -c 'import _rocm_sdk_core, pathlib; print(pathlib.Path(_rocm_sdk_core.__file__).parent)')" /opt/rocm-core \
    && ln -sfn "$(python3 -c 'import _rocm_sdk_libraries, pathlib; print(pathlib.Path(_rocm_sdk_libraries.__file__).parent)')" /opt/rocm-libraries \
    && export PATH=/opt/rocm/bin:/opt/rocm-core/bin:${PATH} \
    && command -v hipcc \
    && test -d /opt/rocm/include/rocprim \
    && test -d /opt/rocm/include/hipcub \
    && test -d /opt/rocm/include/thrust \
    && echo "ROCm SDK layout OK: $(hipcc --version | head -1)"

ENV ROCM_PATH=/opt/rocm \
    ROCM_HOME=/opt/rocm \
    HIP_PATH=/opt/rocm \
    PATH=/opt/rocm/bin:/opt/rocm-core/bin:${PATH} \
    CMAKE_PREFIX_PATH=/opt/rocm/lib/cmake \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm-core/lib:/opt/rocm-libraries/lib \
    PYTORCH_ROCM_ARCH=gfx1151 \
    GPU_TARGETS=gfx1151 \
    VLLM_TARGET_DEVICE=rocm \
    AITER_TRITON_ONLY=1 \
    AITER_USE_SYSTEM_TRITON=1 \
    FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    PIP_NO_CACHE_DIR=1
# GPU_TARGETS is the AMD-cmake arch variable: vLLM's ROCm cmake path keys off
# it, while torch cpp_extension keys off PYTORCH_ROCM_ARCH. Setting BOTH is
# the belt-and-suspenders pin against the silent arch-fallback bug
# (vllm#22590, audited again from the build log at wheel-build time below).
# AITER_TRITON_ONLY/USE_SYSTEM_TRITON: gfx1151 uses only AITER's Triton
# kernels (CK/ASM are CDNA-only), keep the torch-pinned triton; also
# inherited by the nested aiter install in flash-attention's triton-backend
# setup. FLASH_ATTENTION_TRITON_AMD_ENABLE selects ROCm FA's Triton backend
# (the CK backend is gfx90a/942/950-only) at build AND import time.

# --- rdma-core version gate -------------------------------------------------
# Check Fedora's packaged rdma-core; only if older than v64 build an overlay
# into /opt/rdma-overlay (copied over /usr in the final stage).
# CMAKE_INSTALL_SBINDIR=bin: Fedora is usrmerged (/usr/sbin is a symlink to
# bin), so an overlay containing a real sbin/ dir would fail the final
# stage's `cp -a ... /usr/` with "cannot overwrite non-directory".
RUN set -e; \
    mkdir -p /opt/rdma-overlay; \
    installed=$(dnf repoquery -q --qf '%{VERSION}' rdma-core 2>/dev/null | sort -V | tail -1); \
    echo "Fedora rdma-core candidate: ${installed:-unknown}"; \
    major=${installed%%.*}; \
    if [ -n "$installed" ] && [ "$major" -ge "${RDMA_CORE_MIN_MAJOR}" ]; then \
        echo "rdma-core ${installed} >= v${RDMA_CORE_MIN_MAJOR}, no overlay needed"; \
    else \
        echo "rdma-core ${installed:-missing} < v${RDMA_CORE_MIN_MAJOR} - building ${RDMA_CORE_REF} from source"; \
        dnf install -y ${DNF_FLAGS} python3-docutils libudev-devel systemd-devel ethtool lsof && dnf clean all; \
        git clone --depth 1 --branch "${RDMA_CORE_REF}" https://github.com/linux-rdma/rdma-core /tmp/rdma-core; \
        cmake -S /tmp/rdma-core -B /tmp/rdma-core/build -GNinja \
            -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
            -DCMAKE_INSTALL_SBINDIR=bin \
            -DNO_MAN_PAGES=1 -DNO_PYVERBS=1 -DENABLE_RESOLVE_NEIGH=0; \
        DESTDIR=/opt/rdma-overlay ninja -C /tmp/rdma-core/build install; \
    fi

# --- vLLM source build ------------------------------------------------------
WORKDIR /opt/src
# Fetch works for both tags and raw commit SHAs (GitHub allows fetching
# reachable SHAs directly). Tag-looking refs (vX.Y.Z) are fetched with an
# explicit tag refspec so the versioning backend (vcs_versioning) sees the
# tag and stamps the wheel with the real version instead of 0.1.dev1.
RUN git init vllm \
    && cd vllm \
    && git remote add origin https://github.com/vllm-project/vllm.git \
    && if [[ "${VLLM_REF}" =~ ^v[0-9] ]]; then \
           git fetch --depth 1 origin "refs/tags/${VLLM_REF}:refs/tags/${VLLM_REF}"; \
       else \
           git fetch --depth 1 origin "${VLLM_REF}"; \
       fi \
    && git checkout --detach FETCH_HEAD

# Patch layer. apply_all.sh runs with VLLM_SRC pointing at the checkout;
# --skip-verify because vLLM is not pip-installed in this stage yet (imports
# would fail) — marker/structure checks run separately right after.
COPY patches/ /opt/src/patches/
RUN cd /opt/src/vllm \
    && if [ -f /opt/src/patches/apply_all.sh ]; then \
           VLLM_SRC=/opt/src/vllm bash /opt/src/patches/apply_all.sh --skip-verify; \
           python3 /opt/src/patches/verify_compat.py --src /opt/src/vllm --skip-imports; \
       else \
           echo "WARNING: patches/apply_all.sh not found, building unpatched vLLM"; \
       fi

# Build requirements: vLLM moves these between releases - v0.28 has
# requirements/build/rocm.txt, older trees requirements/rocm-build.txt or
# requirements/build.txt. The torch stack lines (torch/torchvision/
# torchaudio/triton pins + the upstream pytorch.org ROCm index-url) are
# FILTERED OUT: the image builds against the AMD gfx1151 whl-multi-arch
# stack installed above, and letting upstream pins through would downgrade
# or clobber it. The filtered copy is written next to the original so
# relative includes (-r ../common.txt) keep resolving. A post-install
# assertion on the torch version is the fail-closed guard against a
# clobbered torch.
# The build log is captured and audited for the gfx1151 arch pin: vLLM's ROCm
# build has a known silent-fallback bug (vllm#22590) where an unpicked
# PYTORCH_ROCM_ARCH compiles for the default multi-arch list instead of
# failing - the wheel then JIT-fails or silently mis-runs on gfx1151. The
# grep audit below is the hard guard: the log must mention gfx1151, and no
# HIP device-compile flag may name any other gfx arch. `pip wheel -v` is
# REQUIRED: pip discards a successful build's subprocess output otherwise,
# leaving the audit an empty log to grep.
RUN cd /opt/src/vllm \
    && for cand in requirements/build/rocm.txt requirements/rocm-build.txt requirements/build.txt; do \
           if [ -f "$cand" ]; then REQ="$cand"; break; fi; \
       done; \
       [ -n "${REQ:-}" ] || { echo "FATAL: no ROCm build requirements file found"; exit 1; }; \
    echo "Using build requirements: $REQ (torch stack lines filtered)" \
    && filtered="${REQ%.txt}-gfx1151-filtered.txt" \
    && grep -vE '^[[:space:]]*(torch|torchvision|torchaudio|triton)([=<>![]|$)|^[[:space:]]*--(extra-)?index-url' "$REQ" > "$filtered" \
    && python3 -m pip install -r "$filtered" \
    && python3 -c "import torch; assert torch.__version__.startswith('${TORCH_VERSION}+rocm'), 'torch clobbered: '+torch.__version__; print('torch pin intact:', torch.__version__)" \
    && mkdir -p /wheels \
    && set -o pipefail \
    && MAX_JOBS=$(nproc) python3 -m pip wheel -v --no-build-isolation --no-deps -w /wheels . 2>&1 | tee /tmp/vllm-build.log \
    && grep -q 'gfx1151' /tmp/vllm-build.log \
    && bad=$(grep -oE '(--offload-arch=|-mcpu=|--amdgpu-target=|--gpu-target=)gfx[0-9a-z]+' /tmp/vllm-build.log \
             | grep -oE 'gfx[0-9a-z]+$' | sort -u | grep -vx 'gfx1151' || true) \
    && if [ -n "$bad" ]; then \
           echo "FATAL: vLLM wheel compiled for non-gfx1151 archs (silent fallback, vllm#22590):"; \
           echo "$bad"; \
           echo "Refusing to ship a multi-arch wheel for a gfx1151-only image."; \
           exit 1; \
       fi \
    && echo "Arch audit OK: HIP compile flags target gfx1151 only"

# --- AITER, conch-triton-kernels, ROCm flash-attention ----------------------
# Order matters at runtime (vLLM imports AITER/conch before attention
# backends); we build wheels here and install in the same order in the final
# stage. AITER setup.py imports torch, so it needs --no-build-isolation.
# AITER_TRITON_ONLY=1: on gfx1151 only AITER's Triton kernels are usable
# (CK/ASM kernels are CDNA-only - patch 54's design), so skip the entire
# C++/CK/HIP build; this also sidesteps CK's missing gfx1151 instantiations.
# AITER_USE_SYSTEM_TRITON=1: keep the torch-pinned TheRock triton instead of
# letting AITER's install_triton.sh replace it.
RUN python3 -m pip install pybind11 psutil pandas "flydsl==0.2.4" \
    && python3 -m pip wheel --no-build-isolation --no-deps -w /wheels \
        "git+https://github.com/ROCm/aiter.git@${AITER_REF}"
RUN python3 -m pip download --no-deps -d /wheels "conch-triton-kernels==${CONCH_VERSION}"
# ROCm flash-attention, branch main_perf (the gfx-tuned line), Triton backend
# (FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE in the stage ENV): the CK backend
# only allows gfx90a/gfx942/gfx950 and needs the composable_kernel submodule;
# the Triton backend routes through aiter.ops.triton (pure python wheel -
# hence the AITER_TRITON_ONLY build above - provides it at runtime).
# setup.py self-inits its third_party/aiter submodule (pip-installs it for
# the build, inheriting the AITER_* env). No GPU needed at build time.
RUN git clone --depth 1 --branch main_perf https://github.com/ROCm/flash-attention /opt/src/flash-attention \
    && cd /opt/src/flash-attention \
    && FLASH_ATTENTION_FORCE_BUILD=TRUE MAX_JOBS=$(nproc) \
       python3 -m pip wheel --no-build-isolation --no-deps -w /wheels .

# ---------------------------------------------------------------------------
FROM fedora:${FEDORA_VERSION} AS final

ARG ROCM_VERSION=7.14.0
ARG TORCH_VERSION=2.13.0
ARG TORCHVISION_VERSION=0.28.0
ARG RCCL_IMPL=stock
ARG CONCH_VERSION=1.2.1
ARG ROCM_INDEX_URL=https://repo.amd.com/rocm/whl-multi-arch/

ENV DNF_FLAGS="--setopt=install_weak_deps=False --setopt=tsflags=nodocs"

# Runtime userspace: python 3.12 + RDMA tooling (ibv_devices via
# libibverbs-utils, perftest for link validation). ROCm itself comes from the
# TheRock pip SDK (same as builder, incl. devel, so Triton/AITER JIT and
# hipcc-based compiles work on the nodes). binutils provides ld for JIT
# linkers; numactl-libs/libdrm/libatomic are HSA thunk deps. gcc is REQUIRED:
# Triton's runtime build.py compiles its C launcher stubs on first use and
# dies with "Failed to find C compiler" without it (hit on StrixHalo1).
RUN dnf install -y ${DNF_FLAGS} \
        python3.12 python3.12-devel curl-minimal binutils gcc \
        numactl-libs libdrm libatomic \
        rdma-core libibverbs-utils librdmacm-utils perftest \
    && dnf clean all

RUN curl -fsSL https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py \
    && python3.12 /tmp/get-pip.py --no-cache-dir \
    && rm -f /tmp/get-pip.py \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3

# gfx1151 torch stack + full ROCm SDK (same index/versions as builder).
RUN python3 -m pip install \
        --index-url "${ROCM_INDEX_URL}" \
        --extra-index-url https://pypi.org/simple \
        "torch==${TORCH_VERSION}+rocm${ROCM_VERSION}" \
        "amd-torch-device-gfx1151==${TORCH_VERSION}+rocm${ROCM_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}+rocm${ROCM_VERSION}" \
        "amd-torchvision-device-gfx1151==${TORCHVISION_VERSION}+rocm${ROCM_VERSION}" \
        "rocm[devel]==${ROCM_VERSION}" \
    && python3 -m pip install pyyaml

RUN python3 -m rocm_sdk init \
    && ln -sfn "$(python3 -m rocm_sdk path --root)" /opt/rocm \
    && ln -sfn "$(python3 -c 'import _rocm_sdk_core, pathlib; print(pathlib.Path(_rocm_sdk_core.__file__).parent)')" /opt/rocm-core \
    && ln -sfn "$(python3 -c 'import _rocm_sdk_libraries, pathlib; print(pathlib.Path(_rocm_sdk_libraries.__file__).parent)')" /opt/rocm-libraries \
    && printf '%s\n' /opt/rocm/lib /opt/rocm-core/lib /opt/rocm-libraries/lib \
        > /etc/ld.so.conf.d/zz-rocm-pip-sdk.conf \
    && ldconfig

ENV ROCM_PATH=/opt/rocm \
    ROCM_HOME=/opt/rocm \
    HIP_PATH=/opt/rocm \
    PATH=/opt/rocm/bin:/opt/rocm-core/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm-core/lib:/opt/rocm-libraries/lib \
    PYTORCH_ROCM_ARCH=gfx1151 \
    GPU_TARGETS=gfx1151 \
    PIP_NO_CACHE_DIR=1

# rdma-core overlay (only populated when Fedora's package was < v64).
COPY --from=builder /opt/rdma-overlay /opt/rdma-overlay
RUN if [ -n "$(ls -A /opt/rdma-overlay 2>/dev/null)" ]; then \
        echo "Applying rdma-core source-built overlay"; \
        cp -a /opt/rdma-overlay/usr/. /usr/ && ldconfig; \
    else \
        echo "Using Fedora-packaged rdma-core (>= v64)"; \
    fi \
    && rm -rf /opt/rdma-overlay

# Prebuilt wheels, installed in dependency order: AITER -> conch ->
# flash-attention -> vLLM. vLLM deps resolve from PyPI plus the gfx1151 index
# so no CUDA torch is pulled in accidentally.
COPY --from=builder /wheels /wheels
RUN set -e; \
    python3 -m pip install --no-deps $(ls /wheels/*aiter*.whl); \
    python3 -m pip install --no-deps /wheels/conch_triton_kernels-*.whl; \
    python3 -m pip install --no-deps /wheels/flash_attn-*.whl; \
    python3 -m pip install --extra-index-url \
        "${ROCM_INDEX_URL}" \
        /wheels/vllm-*.whl; \
    python3 -m pip install "ray[default]"; \
    rm -rf /wheels

# --- Dependency cut-list (text-MoE cluster, models from local disk) --------
# gfx1151-only specialization: remove vLLM transitive deps this image never
# exercises. Each removal is safe ONLY while the cluster serves text MoE
# models loaded from local NVMe - re-add the package if that changes.
# pip uninstall of an absent package is a no-op warning (exit 0), so this
# stays safe across vLLM dependency churn.
RUN set -e; \
    # runai-model-streamer: S3/GCS/Azure weight streaming; this cluster loads
    # models from local disk, so the cloud streaming path is dead weight. \
    # datasets: HF datasets lib, pulled in for offline eval/bench paths; the
    # serving stack never imports it. \
    # peft: LoRA training/adapter toolkit; inference-only image. \
    # amd-quark: AMD quantization toolchain; unused - registry models run
    # through vLLM's own quant paths. \
    # timm + opencv-python-headless: vision-encoder deps; models/registry.yaml
    # has NO vision model. MUST be re-added if a vision model is added. \
    python3 -m pip uninstall -y \
        runai-model-streamer \
        datasets \
        peft \
        amd-quark \
        timm \
        opencv-python-headless; \
    # Deliberately NOT cut: numba (n-gram speculative decode), tokenizers,
    # the xgrammar/llguidance/outlines structured-output stack, everything
    # Triton/conch, and depyf/cloudpickle - the Inductor path must survive for
    # the --compilation-config '{"cudagraph_mode":"NONE"}' A/B experiment. \
    # \
    # CUDA-only reqs: assert absent (never installable from the ROCm index,
    # and a leak here means a CUDA wheel crept into a gfx1151 image). \
    if python3 -m pip list --format=freeze | grep -qiE '^(flashinfer|bitsandbytes)[= -]'; then \
        echo "FATAL: CUDA-only dependency leaked into the gfx1151 image:"; \
        python3 -m pip list --format=freeze | grep -iE '^(flashinfer|bitsandbytes)[= -]'; \
        exit 1; \
    fi; \
    # Fail-safe: if the cut-list broke the import graph, reinstall the cut
    # packages and warn rather than ship a broken image. The final import
    # runs unconditionally, so a still-broken image fails the build here. \
    if ! python3 -c 'import vllm'; then \
        echo "WARNING: 'import vllm' failed after dependency cut - reinstalling cut packages"; \
        python3 -m pip install \
            runai-model-streamer datasets peft amd-quark timm opencv-python-headless; \
    fi; \
    python3 -c 'import vllm; print("vLLM import OK after dependency cut:", vllm.__version__)'

# --- Custom RCCL for gfx1151 ------------------------------------------------
# NOTE: ROCm/rocm-systems#5229 (RCCL broken on gfx1151 in TheRock builds) is
# CLOSED - fixed via ROCm/TheRock#4935 + #5376, and librccl.so ships in the
# rocm-sdk-libraries wheel this image installs. Stock RCCL is therefore
# expected to work; RCCL_IMPL=custom remains as a fallback and expects
# patches/librccl/librccl.so in the build context (produced by the
# build-rccl.yml workflow or placed manually from the known-good
# kyuz0/rocm-systems gfx1151-rccl build). Missing file -> warn and keep stock.
COPY patches/ /opt/patches/
RUN if [ "${RCCL_IMPL}" = "custom" ]; then \
        if [ -f /opt/patches/librccl/librccl.so ]; then \
            echo "Installing custom gfx1151 RCCL"; \
            sdk_libs="$(python3 -c 'import _rocm_sdk_libraries, pathlib; print(pathlib.Path(_rocm_sdk_libraries.__file__).parent)')/lib"; \
            for f in ${sdk_libs}/librccl.so* \
                     /usr/local/lib*/python3.12/site-packages/torch/lib/librccl.so*; do \
                [ -e "$f" ] || continue; \
                [ -e "${f}.stock" ] || cp -a "$f" "${f}.stock"; \
                cp -f /opt/patches/librccl/librccl.so "$f"; \
            done; \
            ldconfig; \
        else \
            echo "WARNING: RCCL_IMPL=custom but patches/librccl/librccl.so is missing; falling back to stock RCCL"; \
        fi; \
    fi \
    && echo "Post-install patch: torch rtld knob (final stage reinstalls torch pristine)" \
    && python3 /opt/patches/20_rocm_smi_rtld.py \
    && echo "Post-install patch: conch triton_kernels gfx1x MXFP4 MoE tune" \
    && python3 /opt/patches/50_conch_moe_mxfp4_tune.py \
    && echo "Post-install patch: AITER Triton enablement for gfx1151" \
    && python3 /opt/patches/54_aiter_rdna_enable.py \
        --src /opt/src/vllm \
        --site-packages "$(python3 -c 'import site; print(site.getsitepackages()[0])')" \
    && echo "Full compatibility check against the installed packages" \
    && python3 /opt/patches/verify_compat.py \
        --src "$(python3 -c 'import vllm, pathlib; print(pathlib.Path(vllm.__file__).parent.parent)')" \
    && rm -rf /opt/patches

# tilelang: required at runtime by the vendored sparse-indexer kernels
# (patches/vendor/gfx1x_tilelang_mqa.py via patch 52). Best-effort: patch 52
# degrades gracefully to the upstream path without it, so a missing/broken
# tilelang wheel warns instead of failing the build. vLLM v0.28+ pins
# tilelang (with apache-tvm-ffi) as a runtime dep, so this only installs
# when that pin is absent - an unpinned reinstall could otherwise upgrade
# past vLLM's pin and break the tvm-ffi pairing.
RUN python3 -c 'import tilelang' 2>/dev/null \
    || python3 -m pip install tilelang \
    || echo "WARNING: tilelang install failed - sparse-indexer TileLang kernels will fall back to upstream path"

# Patch 50 (patches/50_conch_moe_mxfp4_tune.py) is deliberately NOT applied by
# apply_all.sh in the builder stage: it edits the INSTALLED triton_kernels
# package (vendored into the vLLM wheel at vllm/third_party/triton_kernels),
# which only exists after the pip install above. It defers with SKIP/exit 0
# pre-install and must succeed here (fail-closed: exit 42 = re-audit).
# Patch 20 targets the INSTALLED torch package; the builder patched its own
# torch (marker verified there), but this stage reinstalls torch pristine,
# so it re-runs here.
# Patch 54 is split the same way: the vLLM-tree side was applied in the
# builder stage, the aiter/arch_info side targets the installed packages and
# runs here.

# Fused-MoE tuned Triton configs: vLLM checks $VLLM_TUNED_CONFIG_FOLDER
# before the wheel-bundled configs, so no source patching is needed
# (see patches/configs/README.md). The baked files are untuned PLACEHOLDERS
# until replaced by bench/tune_moe.py output.
COPY patches/configs/ /opt/vllm-tuned-configs/

# gfx1151 runtime defaults (see models/registry.yaml and README):
#  - AITER off by default: heavily gated on gfx1x
#  - gfx1x MoE tune on: measured 11.3 -> 21.8 tok/s decode on MoE models
#  - FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE: import-time backend selection in
#    flash_attn/flash_attn_interface.py (routes to aiter.ops.triton) - must
#    match the Triton backend the wheel was built with above
#  - Triton cache location: bind-mount a host dir here to avoid ~170 s JIT
#    on every cold start
#  - TRITON_STORE_BINARY_ONLY=1: strips source/intermediate files from the
#    baked Triton cache (~77% smaller, keeps .hsaco+.json - Red Hat verified).
#    Safe because the cache is only JIT'd/loaded on identical gfx1151 nodes.
ENV VLLM_ROCM_USE_AITER=0 \
    VLLM_GFX1X_MOE_TUNE=1 \
    FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    VLLM_TUNED_CONFIG_FOLDER=/opt/vllm-tuned-configs \
    VLLM_HOST_TRITON_CACHE=/root/.cache/vllm/triton \
    TRITON_STORE_BINARY_ONLY=1
RUN mkdir -p /root/.cache/vllm/triton

COPY docker/smoke_test.sh /usr/local/bin/smoke_test.sh
RUN chmod +x /usr/local/bin/smoke_test.sh

WORKDIR /root
CMD ["bash"]
